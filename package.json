{
  "name": "dolink-app-client",
  "version": "1.0.0",
  "main": "./index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,json}\"",
    "prepare": "husky",
    "orval": "orval --config orval.config.js",
    "build:android": "bundle exec fastlane build",
    "deploy": "bundle exec fastlane playstore",
    "build:deploy": "bundle exec fastlane build_and_deploy"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dexical/expo-store-signing": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^55.0.8",
    "expo-share-extension": "^5.0.5",
    "expo-share-intent": "^5.1.1",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-nitro-cookies": "^1.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "expo-dev-client": "^6.0.20",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "orval": "^8.2.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "react-native-svg-transformer": "^1.5.2",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.3"
  },
  "private": true
}
