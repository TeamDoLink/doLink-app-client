# 개발 모드
# - iOS 시뮬레이터: DOMAIN 사용
# - Android 에뮬레이터: ANDROID_EMULATOR_DOMAIN 사용
# - iOS/Android 실기기: localhost를 로컬 IP로 변경 필요

# 사용 방법:
# 1. 이 파일을 .env.local로 복사
# 2. 실기기 테스트 시 EXPO_PUBLIC_DOMAIN을 본인의 로컬 IP로 변경 (예: 192.168.x.x:5173)

# iOS 시뮬레이터 / 실기기용
EXPO_PUBLIC_DOMAIN=http://localhost:5173
EXPO_PUBLIC_API_URL=http://localhost:5173

# Android 에뮬레이터 전용 (10.0.2.2 = 호스트 머신)
EXPO_PUBLIC_ANDROID_EMULATOR_DOMAIN=http://10.0.2.2:5173
